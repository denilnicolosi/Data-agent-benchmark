# API Keys and Endpoint configurations

# 1. Aegra Server Location
AEGRA_URL=http://localhost:2026

# Required to run plain `aegra dev` (hot-reload on): excludes the winning
# script the workflow writes into output/<thread-id>/ from the reload watcher,
# so the server doesn't restart mid-run. aegra dev loads this .env and the
# uvicorn CLI picks the option up from the environment (UVICORN_* prefix).
UVICORN_RELOAD_EXCLUDES=output/*/*.py

# 2. LLM Model (provider-agnostic, LangChain init_chat_model format "provider:model")
#    Examples: openai:gpt-4o-mini | anthropic:claude-sonnet-5 | ollama:llama3
#    The matching integration package must be installed (langchain-openai, langchain-anthropic, ...)
LLM_MODEL=openai:gpt-5-mini

# Completion-token budget for code generation (default 16000). Some providers
# default to a tiny budget (ChatNVIDIA: 1024) and reasoning models also spend
# it on hidden reasoning tokens; too low a value truncates the generated code.
# LLM_MAX_TOKENS=16000

# Set to 0 to skip structured output and ask for the code in a plain markdown
# fence instead. Structured output embeds the script in a JSON string field,
# and some models (NIM-served nemotron/gpt-oss) corrupt the escaping, so the
# code never compiles; those failures auto-fall-back to plain mode anyway, but
# setting 0 avoids the wasted structured call per generation.
# LLM_STRUCTURED_OUTPUT=1

# API key(s) for the chosen provider; set only the one(s) you actually use
OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 3. Telegram Bot Configuration (Required: the whole session flow is driven from the Telegram chat)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# 4. Paths (Optional - server-side deployment config, NOT per-run data)
# SQLite database used by the benchmarks, resolved on the Aegra server
# (generated on first use if missing). In full-container mode the compose
# file already loads this .env into the API container via env_file.
ANALYTICS_DB_PATH=data/analytics.db
# Base folder for per-session artifacts (<base>/<thread_id>/...). IMPORTANT:
# if you change this, update UVICORN_RELOAD_EXCLUDES above to match
# (<base>/*/*.py), otherwise `aegra dev` hot-reload restarts the server when
# the report node writes the winning script into the output folder.
OUTPUT_BASE_DIR=output

# 5. Benchmark container caps (docker run flags: --memory / --cpus).
# Containers also run with --network none; executions are serialized so every
# library is measured on identical, uncontended resources.
# BENCHMARK_MEMORY_LIMIT=2g
# BENCHMARK_CPU_LIMIT=2

# 6. Observability (optional) - handled NATIVELY by Aegra, zero code in this
# repo: the server instruments all LangChain/LangGraph activity (OpenInference)
# and exports OTEL spans to Langfuse's OTLP endpoint. Spans arrive already
# enriched: langfuse.session.id = Aegra thread id (one Langfuse session per
# workflow session), trace name = graph id, run_id/thread_id/graph_id as
# filterable metadata. Do NOT add the langfuse CallbackHandler in the graph:
# it would double-trace every call.
# OTEL_TARGETS=LANGFUSE
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional: centralized Prompt Management. Requires `pip install langfuse`
# and a one-shot `python seed_langfuse_prompts.py` (creates the 5 prompts
# with label "production"). When on, prompt text AND model config
# ({"model", "max_tokens"} in the prompt's config) come from Langfuse; SDK
# client cache ~60s, automatic fallback to the local prompts.py when the
# fetch fails. Edits in the Langfuse UI go live without redeploy.
# LANGFUSE_PROMPTS=1
# LANGFUSE_PROMPT_LABEL=production

